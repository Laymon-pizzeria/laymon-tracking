<!DOCTYPE html>
<html lang="es-MX">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Tu pedido va en camino | Laymon Pizzería Artesanal</title>
<meta name="description" content="Sigue tu pedido de Laymon Pizzería Artesanal en tiempo real.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chelsea+Market&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/tracking.css">
</head>
<body>

  <header class="lm-header">
    <div class="lm-header__inner">
      <img class="lm-logo" src="/static/img/logo-blanco-rojo.png" alt="Laymon Pizzería Artesanal" width="56" height="56">
      <div class="lm-tagline">Pizzería Artesanal</div>
    </div>
  </header>

  <main class="lm-main">

    <section class="lm-status">
      <p class="lm-status__eyebrow">Pedido en camino</p>
      <h1 class="lm-status__message"><%= content.mensaje_principal %></h1>
    </section>

    <section class="lm-map">
      <div class="lm-map__frame">
        <iframe
          src="<%= mexyUrl %>"
          title="Tracking del repartidor"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>

