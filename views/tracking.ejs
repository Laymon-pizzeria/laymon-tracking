<!DOCTYPE html>
<html lang="es-MX">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Tu pedido va en camino | Laymon Pizzería Artesanal</title>
<meta name="description" content="Sigue tu pedido de Laymon Pizzería Artesanal en tiempo real.">
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chelsea+Market&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/tracking.css">
</head>
<body>

  <header class="lm-header">
    <% if (content.barra_promo) { %>
    <div class="lm-header__promo-bar"><span class="lm-header__promo-bar__track"><%= content.barra_promo %></span></div>
    <% } %>
    <div class="lm-header__inner">
      <a href="https://laymonpizzeria.com" target="_blank" rel="noopener" class="lm-logo-link">
        <span class="laymon-vhs-wrap" style="--laymon-logo-url: url('/static/img/logo-blanco.png');">
          <img class="lm-logo" src="/static/img/logo-blanco.png" alt="Laymon Pizzería Artesanal">
          <span class="laymon-vhs-ghost c" aria-hidden="true"></span>
          <span class="laymon-vhs-ghost y" aria-hidden="true"></span>
          <span class="laymon-vhs-ghost m" aria-hidden="true"></span>
        </span>
      </a>
    </div>
  </header>

  <main class="lm-main">

    <section class="lm-status">
      <p class="lm-status__eyebrow">Pedido en camino</p>
      <h1 class="lm-status__message"><%= content.mensaje_principal %></h1>
    </section>

    <section class="lm-map">
      <div class="lm-map__frame">
        <iframe
          src="<%= mexyUrl %>"
          title="Tracking del repartidor"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </section>

    <% if (content.promo_titulo || content.promo_texto) { %>
    <section class="lm-promo">
      <p class="lm-promo__eyebrow">Esta semana en Laymon</p>
      <% const promoTag = content.promo_link ? 'a' : 'div'; %>
      <<%= promoTag %> class="lm-promo__card"<% if (content.promo_link) { %> href="<%= content.promo_link %>" target="_blank" rel="noopener"<% } %>>
        <% if (content.promo_imagen) { %>
          <div class="lm-promo__img" style="background-image:url('<%= content.promo_imagen %>')"></div>
        <% } %>
        <div class="lm-promo__body">
          <% if (content.promo_titulo) { %><h2 class="lm-promo__title"><%= content.promo_titulo %></h2><% } %>
          <% if (content.promo_texto) { %><p class="lm-promo__text"><%= content.promo_texto %></p><% } %>
        </div>
        <% if (content.promo_link) { %><span class="lm-promo__cta" aria-label="Ver más">+</span><% } %>
      </<%= promoTag %>>
    </section>
    <% } %>

    <section class="lm-suggestion">
      <p class="lm-suggestion__label">Mientras esperas</p>
      <p class="lm-suggestion__text" id="lm-suggestion-text"><%= content.sugerencia_random %></p>
    </section>

  </main>

  <a href="https://wa.me/525535023665" class="lm-whatsapp" title="Contáctanos por WhatsApp" target="_blank" rel="noopener">
    <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
      <path d="M16.004 3C9.377 3 4 8.373 4 14.997c0 2.276.63 4.474 1.827 6.4L4 29l7.79-1.79a12.94 12.94 0 0 0 4.214.703h.006c6.627 0 12.004-5.373 12.004-11.996C28.014 8.373 22.637 3 16.004 3Zm0 21.86h-.005a9.86 9.86 0 0 1-5.02-1.375l-.36-.213-3.72.856.887-3.63-.235-.373a9.834 9.834 0 0 1-1.51-5.258c0-5.446 4.436-9.878 9.968-9.878 2.663 0 5.166 1.038 7.047 2.923a9.86 9.86 0 0 1 2.917 7.02c0 5.445-4.436 9.928-9.969 9.928Zm5.465-7.42c-.3-.15-1.775-.876-2.05-.976-.276-.1-.477-.15-.678.15-.2.301-.777.977-.953 1.178-.176.2-.351.226-.652.075-.3-.15-1.267-.467-2.414-1.49-.892-.796-1.495-1.78-1.67-2.08-.176-.3-.019-.463.132-.612.135-.135.301-.351.451-.527.15-.176.2-.301.301-.502.1-.2.05-.376-.025-.527-.075-.15-.677-1.634-.928-2.238-.244-.586-.492-.507-.678-.517-.176-.008-.376-.01-.577-.01a1.11 1.11 0 0 0-.803.376c-.276.301-1.054 1.03-1.054 2.512 0 1.482 1.079 2.914 1.23 3.115.15.2 2.124 3.24 5.146 4.545.719.31 1.28.495 1.717.634.721.229 1.377.197 1.897.12.579-.087 1.775-.727 2.026-1.428.25-.702.25-1.303.176-1.428-.075-.126-.276-.201-.577-.352Z"/>
    </svg>
  </a>

  <footer class="lm-footer">
    <nav class="lm-footer__nav">
      <a href="https://maps.app.goo.gl/JotP1qxJnMBJTTzD9" class="lm-footer__link" target="_blank" rel="noopener">📍 Ubicación</a>
      <a href="https://www.laymonpizzeria.com/preguntas-frecuentes-1" class="lm-footer__link" target="_blank" rel="noopener">❓ Preguntas frecuentes</a>
      <a href="https://laymonpizzeria.getjusto.com/reservas" class="lm-footer__link" target="_blank" rel="noopener">🛒 Reservar</a>
      <a href="https://open.spotify.com/playlist/6XAcaR5LWKgsEgesujMqM6?si=f8aa349ac7294014" class="lm-footer__link" target="_blank" rel="noopener">🎵 Nuestra playlist</a>
    </nav>
    <div class="lm-footer__tagline">Laymon es más que comida, es actitud, pasión y buena música. 🔥</div>
    <p class="lm-footer__credit">Hecho con mucho fuego y coraje — © <%= new Date().getFullYear() %> Laymon.</p>
  </footer>

  <script>
    window.__LM_SUGGESTIONS__ = <%- JSON.stringify(content.sugerencias || []).replace(/</g, '\\u003c') %>;
  </script>
  <script src="/static/js/tracking.js"></script>
</body>
</html>
