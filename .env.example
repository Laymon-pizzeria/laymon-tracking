# Puerto del servidor (Render lo asigna automático, no lo toques en producción)
PORT=3000

# URL del Google Sheet publicado como CSV (ver README para cómo generar esta URL)
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/TU_ID_AQUI/pub?output=csv

# Dominio base de Mexy donde viven los trackings originales
MEXY_BASE_URL=https://laymon.mxy.mx/rastreo

# Cada cuánto (en minutos) el server vuelve a leer el Google Sheet en vez de usar el cache
SHEET_CACHE_MINUTES=5
